{
    "name": "dsh-fish-jiyu",
    "version": "0.4.4",
    "type": "module",
    "description": "Linear-projection context compaction for DeepSeek Harness: near history verbatim, mid as one fact line per block, far as keywords plus seq pointers; every projection is rebuilt from the raw session log, and the pristine text can be searched (jiyu_search), paged back (jiyu_recall) or listed by block (jiyu_blocks).",
    "keywords": [
        "dsh",
        "compaction",
        "context",
        "memory",
        "recall",
        "linear"
    ],
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./engine": "./index.js",
        "./tool": "./tool.js",
        "./view": "./view.js",
        "./client": "./client.js",
        "./lib/*": "./lib/*",
        "./locale/*.json": "./locale/*.json",
        "./icon": "./icon.svg",
        "./package.json": "./package.json"
    },
    "files": [
        "index.js",
        "tool.js",
        "view.js",
        "client.js",
        "inspect.html",
        "lib",
        "cordis.patch.yml",
        "locale/*.json",
        "docs",
        "icon.svg",
        "README.md",
        "LICENSE",
        "install.ps1",
        "uninstall.ps1",
        "install.sh",
        "uninstall.sh",
        "test"
    ],
    "license": "MIT",
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": [
                "slots"
            ]
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GuyeQiuchen/dsh-fish-jiyu.git"
    },
    "homepage": "https://github.com/GuyeQiuchen/dsh-fish-jiyu#readme",
    "engines": {
        "node": ">=20.11"
    }
}
